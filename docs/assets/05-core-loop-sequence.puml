@startuml

actor Jugador
participant "PlayerActor" as Actor
participant "LocalAdapter" as Adapter
participant "EventBus" as Events
participant "GameDomain" as Domain
participant "Inventory" as Inventory
participant "HUD" as Hud

Jugador -> Actor: input interactuar
Actor -> Adapter: Intent(interact)
Adapter -> Domain: apply(intent)
Domain -> Inventory: add(itemId, 1)
Inventory --> Domain: accepted
Domain --> Events: ItemCollected
Events --> Hud: refresh inventory
Hud --> Jugador: muestra item
@enduml
