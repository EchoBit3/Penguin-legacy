@startuml

actor Jugador
participant "PlayerActor" as Actor
participant "Main" as Main
participant "Interactable" as Item
participant "Inventory" as Inventory
participant "InventoryPanel" as Panel

Jugador -> Actor: input interactuar
Actor -> Main: interaction_requested
Main -> Item: try_interact
Item -> Inventory: add(itemId, 1)
Inventory --> Item: accepted
Item --> Main: item_collected
Main -> Panel: changed
Panel --> Jugador: muestra item
@enduml
