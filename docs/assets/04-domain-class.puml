@startuml
top to bottom direction

class Penguin {
  +id: int
  +displayName: String
  +roomId: String
}

class Inventory {
  -items: Map
  +add(itemId, quantity)
  +remove(itemId, quantity)
  +has(itemId)
}

note right of Inventory
  quantity never negative
  remove fails atomically
end note

class ItemDefinition {
  +id: String
  +displayName: String
  +category: String
}

class Room {
  +id: String
  +displayName: String
  +spawnPoints: Array
}

interface IntentPort {
  +apply(intent)
}

Penguin "1" o-- "1" Inventory
Inventory "*" --> "1" ItemDefinition
Penguin "*" --> "1" Room
IntentPort ..> Penguin
@enduml
